{
  "name": "Cartera Riesgo",
  "dataColors": ["#2BD9A4", "#8FE3C8", "#F2B84B", "#F0874B", "#E5484D", "#5AA9E6", "#9B8AFB", "#C9D1D9"],
  "good": "#2BD9A4",
  "neutral": "#F2B84B",
  "bad": "#E5484D",
  "maximum": "#E5484D",
  "center": "#F2B84B",
  "minimum": "#2BD9A4",
  "background": "#13212E",
  "foreground": "#E6EDF3",
  "tableAccent": "#2BD9A4",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E6EDF3" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#E6EDF3" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#9FB0BF" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#13212E" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#22384A" } }, "radius": 12 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#000000" } }, "position": "Outer", "preset": "BottomRight", "transparency": 65 }],
        "padding": [{ "top": 10, "bottom": 10, "left": 14, "right": 14 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E6EDF3" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#9FB0BF" } }, "gridlineColor": { "solid": { "color": "#22384A" } }, "gridlineStyle": "dotted", "showAxisTitle": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#9FB0BF" } }, "showAxisTitle": false }],
        "legend": [{ "labelColor": { "solid": { "color": "#C9D4DE" } }, "position": "Top" }],
        "labels": [{ "color": { "solid": { "color": "#E6EDF3" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1620" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#070F16" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 26 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#9FB0BF" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#E6EDF3" } }, "background": { "solid": { "color": "#13212E" } } }],
        "header": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#22384A" } }, "gridVertical": false, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#9FB0BF" } }, "backColor": { "solid": { "color": "#13212E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6EDF3" } }, "backColorPrimary": { "solid": { "color": "#13212E" } },
                     "fontColorSecondary": { "solid": { "color": "#E6EDF3" } }, "backColorSecondary": { "solid": { "color": "#172A3A" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1B3144" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#22384A" } }, "gridVertical": false, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#9FB0BF" } }, "backColor": { "solid": { "color": "#13212E" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#E6EDF3" } }, "backColor": { "solid": { "color": "#13212E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6EDF3" } }, "backColorPrimary": { "solid": { "color": "#13212E" } },
                     "fontColorSecondary": { "solid": { "color": "#E6EDF3" } }, "backColorSecondary": { "solid": { "color": "#172A3A" } } }],
        "subTotals": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1B3144" } } }]
      }
    }
  }
}
