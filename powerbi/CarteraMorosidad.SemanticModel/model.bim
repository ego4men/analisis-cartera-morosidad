{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-ES",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-ES",
    "tables": [
      {
        "name": "fEstado",
        "columns": [
          {
            "name": "credito_id",
            "dataType": "int64",
            "sourceColumn": "credito_id",
            "summarizeBy": "none"
          },
          {
            "name": "cliente_id",
            "dataType": "int64",
            "sourceColumn": "cliente_id",
            "summarizeBy": "none"
          },
          {
            "name": "agencia_id",
            "dataType": "int64",
            "sourceColumn": "agencia_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "producto",
            "dataType": "string",
            "sourceColumn": "producto",
            "summarizeBy": "none"
          },
          {
            "name": "canal",
            "dataType": "string",
            "sourceColumn": "canal",
            "summarizeBy": "none"
          },
          {
            "name": "fecha_desembolso",
            "dataType": "dateTime",
            "sourceColumn": "fecha_desembolso",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "monto_desembolsado",
            "dataType": "double",
            "sourceColumn": "monto_desembolsado",
            "summarizeBy": "sum",
            "formatString": "\"S/ \"#,0"
          },
          {
            "name": "saldo_capital",
            "dataType": "double",
            "sourceColumn": "saldo_capital",
            "summarizeBy": "sum",
            "formatString": "\"S/ \"#,0"
          },
          {
            "name": "cuotas_vencidas",
            "dataType": "int64",
            "sourceColumn": "cuotas_vencidas",
            "summarizeBy": "none"
          },
          {
            "name": "monto_vencido",
            "dataType": "double",
            "sourceColumn": "monto_vencido",
            "summarizeBy": "sum",
            "formatString": "\"S/ \"#,0"
          },
          {
            "name": "dias_atraso",
            "dataType": "int64",
            "sourceColumn": "dias_atraso",
            "summarizeBy": "none"
          },
          {
            "name": "tramo_mora",
            "dataType": "string",
            "sourceColumn": "tramo_mora",
            "summarizeBy": "none"
          },
          {
            "name": "estado",
            "dataType": "string",
            "sourceColumn": "estado",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fEstado",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/ego4men/analisis-cartera-morosidad/main/powerbi/datos/estado_corte.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"credito_id\", Int64.Type}, {\"cliente_id\", Int64.Type}, {\"agencia_id\", Int64.Type}, {\"producto\", type text}, {\"canal\", type text}, {\"fecha_desembolso\", type date}, {\"monto_desembolsado\", type number}, {\"saldo_capital\", type number}, {\"cuotas_vencidas\", Int64.Type}, {\"monto_vencido\", type number}, {\"dias_atraso\", Int64.Type}, {\"tramo_mora\", type text}}, \"en-US\"),",
                "    Estado = Table.AddColumn(Tipos, \"estado\", each if List.Contains({\"Cancelado\", \"Castigado\"}, [tramo_mora]) then [tramo_mora] else \"Vigente\", type text)",
                "in",
                "    Estado"
              ]
            }
          }
        ]
      },
      {
        "name": "fCierre",
        "columns": [
          {
            "name": "fecha_cierre",
            "dataType": "dateTime",
            "sourceColumn": "fecha_cierre",
            "summarizeBy": "none",
            "formatString": "mmm yyyy"
          },
          {
            "name": "credito_id",
            "dataType": "int64",
            "sourceColumn": "credito_id",
            "summarizeBy": "none"
          },
          {
            "name": "producto",
            "dataType": "string",
            "sourceColumn": "producto",
            "summarizeBy": "none"
          },
          {
            "name": "canal",
            "dataType": "string",
            "sourceColumn": "canal",
            "summarizeBy": "none"
          },
          {
            "name": "agencia_id",
            "dataType": "int64",
            "sourceColumn": "agencia_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "saldo_capital",
            "dataType": "double",
            "sourceColumn": "saldo_capital",
            "summarizeBy": "sum",
            "formatString": "\"S/ \"#,0"
          },
          {
            "name": "dias_atraso",
            "dataType": "int64",
            "sourceColumn": "dias_atraso",
            "summarizeBy": "none"
          },
          {
            "name": "tramo_mora",
            "dataType": "string",
            "sourceColumn": "tramo_mora",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fCierre",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/ego4men/analisis-cartera-morosidad/main/powerbi/datos/cierre_mensual.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha_cierre\", type date}, {\"credito_id\", Int64.Type}, {\"producto\", type text}, {\"canal\", type text}, {\"agencia_id\", Int64.Type}, {\"saldo_capital\", type number}, {\"dias_atraso\", Int64.Type}, {\"tramo_mora\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "dAgencia",
        "columns": [
          {
            "name": "agencia_id",
            "dataType": "int64",
            "sourceColumn": "agencia_id",
            "summarizeBy": "none"
          },
          {
            "name": "nombre_agencia",
            "dataType": "string",
            "sourceColumn": "nombre_agencia",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dAgencia",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/ego4men/analisis-cartera-morosidad/main/powerbi/datos/agencias.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"agencia_id\", Int64.Type}, {\"nombre_agencia\", type text}, {\"region\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "dCalendario",
        "columns": [
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy",
            "isKey": true
          },
          {
            "name": "Año",
            "dataType": "int64",
            "sourceColumn": "Año",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "sortByColumn": "MesNumero"
          },
          {
            "name": "MesNumero",
            "dataType": "int64",
            "sourceColumn": "MesNumero",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "dCalendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fechas = List.Dates(#date(2024, 1, 1), Duration.Days(#date(2026, 9, 30) - #date(2024, 1, 1)) + 1, #duration(1, 0, 0, 0)),",
                "    Tabla = Table.FromList(Fechas, Splitter.SplitByNothing(), {\"Fecha\"}),",
                "    Tipo = Table.TransformColumnTypes(Tabla, {{\"Fecha\", type date}}),",
                "    Anio = Table.AddColumn(Tipo, \"Año\", each Date.Year([Fecha]), Int64.Type),",
                "    Mes = Table.AddColumn(Anio, \"Mes\", each Date.ToText([Fecha], \"MMM yyyy\", \"es-PE\"), type text),",
                "    MesNumero = Table.AddColumn(Mes, \"MesNumero\", each Date.Year([Fecha]) * 100 + Date.Month([Fecha]), Int64.Type)",
                "in",
                "    MesNumero"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Columna",
            "dataType": "string",
            "sourceColumn": "Columna",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [Columna = text], {})",
                "in",
                "    Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Saldo Vigente",
            "expression": "CALCULATE ( SUM ( fEstado[saldo_capital] ), fEstado[estado] = \"Vigente\" )",
            "formatString": "\"S/ \"#,0",
            "displayFolder": "Corte"
          },
          {
            "name": "Créditos Vigentes",
            "expression": "CALCULATE ( COUNTROWS ( fEstado ), fEstado[estado] = \"Vigente\" )",
            "formatString": "#,0",
            "displayFolder": "Corte"
          },
          {
            "name": "Saldo Mora 30",
            "expression": "CALCULATE ( [Saldo Vigente], fEstado[dias_atraso] > 30 )",
            "formatString": "\"S/ \"#,0",
            "displayFolder": "Corte"
          },
          {
            "name": "% Mora 30",
            "expression": "DIVIDE ( [Saldo Mora 30], [Saldo Vigente] )",
            "formatString": "0.00%",
            "displayFolder": "Corte"
          },
          {
            "name": "% Mora 90",
            "expression": "DIVIDE ( CALCULATE ( [Saldo Vigente], fEstado[dias_atraso] > 90 ), [Saldo Vigente] )",
            "formatString": "0.00%",
            "displayFolder": "Corte"
          },
          {
            "name": "Saldo Castigado",
            "expression": "CALCULATE ( SUM ( fEstado[saldo_capital] ), fEstado[estado] = \"Castigado\" )",
            "formatString": "\"S/ \"#,0",
            "displayFolder": "Corte"
          },
          {
            "name": "Monto Vencido 1-60",
            "expression": "CALCULATE ( SUM ( fEstado[monto_vencido] ), fEstado[dias_atraso] >= 1, fEstado[dias_atraso] <= 60 )",
            "formatString": "\"S/ \"#,0",
            "displayFolder": "Cobranza"
          },
          {
            "name": "Saldo Mes",
            "expression": "SUM ( fCierre[saldo_capital] )",
            "formatString": "\"S/ \"#,0",
            "displayFolder": "Evolución"
          },
          {
            "name": "% Mora 30 Mes",
            "expression": "DIVIDE ( CALCULATE ( [Saldo Mes], fCierre[dias_atraso] > 30 ), [Saldo Mes] )",
            "formatString": "0.00%",
            "displayFolder": "Evolución"
          },
          {
            "name": "Var. Mora vs Mes Anterior",
            "expression": "VAR actual = [% Mora 30 Mes]\nVAR anterior = CALCULATE ( [% Mora 30 Mes], DATEADD ( dCalendario[Fecha], -1, MONTH ) )\nRETURN IF ( NOT ISBLANK ( anterior ), actual - anterior )",
            "formatString": "+0.00%;-0.00%;0.00%",
            "displayFolder": "Evolución"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_agencia_estado",
        "fromTable": "fEstado",
        "fromColumn": "agencia_id",
        "toTable": "dAgencia",
        "toColumn": "agencia_id"
      },
      {
        "name": "rel_agencia_cierre",
        "fromTable": "fCierre",
        "fromColumn": "agencia_id",
        "toTable": "dAgencia",
        "toColumn": "agencia_id"
      },
      {
        "name": "rel_calendario_cierre",
        "fromTable": "fCierre",
        "fromColumn": "fecha_cierre",
        "toTable": "dCalendario",
        "toColumn": "Fecha"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"fEstado\", \"fCierre\", \"dAgencia\", \"dCalendario\", \"_Medidas\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}